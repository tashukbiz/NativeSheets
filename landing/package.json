{
  "name": "native-sheets-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Landing website and blog for Native Sheets, a macOS XLSX editor.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/make-share-card.mjs && next build",
    "start": "pnpm run preview",
    "preview": "node scripts/serve.mjs out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "content:validate": "tsx scripts/validate-content.ts",
    "verify": "node scripts/verify-build.mjs out",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run verify",
    "test": "tsx --test tests/*.test.ts"
  },
  "packageManager": "pnpm@10.20.0",
  "license": "ISC",
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
